server {
	listen 80 default_server;
	listen [::]:80 default_server;

	root /var/www/html/mysute;

	index index.html index.htm index.nginx-debian.html index.php;

	server_name _;

	location ~ \.php$ {
    		include snippets/fastcgi-php.conf;
    		# Укажите путь к вашему сокету PHP-FPM
    		fastcgi_pass unix:/var/run/php/php8.3-fpm.sock; # Версия PHP может отличаться
}
}
